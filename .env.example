# ---------------------------------------------------------------------------
# Environment template. NOTHING in this file is read by the browser.
# Edge-function secrets are set in Supabase → Project Settings → Edge Functions → Secrets
# (or `supabase secrets set KEY=value`). Never commit real values.
# ---------------------------------------------------------------------------

# Provided automatically to every Supabase Edge Function — do not set manually:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL

# --- Optional AI (translation of non-Arabic items, optional summaries) ---
# Leave AI_PROVIDER unset (or "none") to run 100% rules-based at $0.
AI_PROVIDER=none            # none | anthropic | openai  ("openai" = any OpenAI-compatible API)
AI_API_KEY=                 # provider key; set a monthly spend limit in the provider console too
AI_MODEL=                   # e.g. claude-haiku-5-5 (anthropic) or gpt-4o-mini / gemini-2.0-flash (openai-compatible)
AI_BASE_URL=                # only for openai-compatible, e.g. https://generativelanguage.googleapis.com/v1beta/openai
# Daily call cap is the DB setting `ai_daily_limit` (admin → settings), default 300.

# --- Optional admin alerts (any or both) ---
ALERT_TELEGRAM_BOT_TOKEN=   # from @BotFather
ALERT_TELEGRAM_CHAT_ID=     # your numeric chat id
RESEND_API_KEY=             # resend.com (free tier)
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=           # verified sender, e.g. "Lahza <alerts@yourdomain.com>"

# --- Stored in Supabase Vault by the scheduler migration (not env vars) ---
# project_url   : https://<ref>.supabase.co
# ingest_token  : random 64-hex secret generated inside the database

# --- GitHub Actions repository secret (for nightly backups) ---
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
